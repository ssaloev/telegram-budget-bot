{
  "name": "budged",
  "version": "1.0.0",
  "description": "calculate budget",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "set:env:prod": "dotenv -e .env.production",
    "set:env:dev": "dotenv -e .env.dev",
    "start:prod": "dotenv -e .env.production -- node dist/index.js",
    "start:dev": "dotenv -e .env.dev -- ts-node-dev --respawn --transpile-only src/index.ts",
    "start:dev:type:check": "dotenv -e .env.dev -- ts-node-dev --respawn src/index.ts",
    "build:prod": "dotenv -e .env.production -- npm run build",
    "build:dev": "dotenv -e .env.dev -- npm run build",
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --format=esm",
    "build:docker": "docker build -t budged-bot .",
    "start:docker:prod": "docker run --rm -it --env-file .env.production budged-bot",
    "deploy": "fly deploy --remote-only",
    "restart:deployed:app": "fly apps restart budged-bot",
    "prepare": "husky"
  },
  "author": "SSaloev",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "dotenv-cli": "^9.0.0",
    "esbuild": "^0.25.8",
    "husky": "^9.1.7",
    "oxlint": "^1.12.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.0",
    "grammy": "^1.37.0",
    "mongoose": "^8.16.4",
    "xss": "^1.0.15"
  }
}
